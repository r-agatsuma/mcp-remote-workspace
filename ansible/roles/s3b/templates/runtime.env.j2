# Shared launch contract for later user-manager/daemon/recovery wiring.
PATH=/usr/bin:/bin
HOME={{ mcp_runner_home }}
XDG_CONFIG_HOME={{ mcp_runner_home }}/.config
XDG_DATA_HOME={{ mcp_runner_home }}/.local/share
XDG_CACHE_HOME={{ mcp_runner_home }}/.cache
XDG_STATE_HOME={{ mcp_runner_home }}/.local/state
XDG_RUNTIME_DIR=/run/user/{{ mcp_runner_uid }}
TMPDIR={{ mcp_runtime_tmp }}
