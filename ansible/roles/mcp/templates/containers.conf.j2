[containers]
mounts = []
volumes = []
log_driver = "k8s-file"
log_size_max = 1048576

[engine]
cgroup_manager = "systemd"
runtime = "crun"
# Podman 4.9 rootless systemd default parent is user.slice; source #93 checks
# the actual full libpod path. There is no containers.conf cgroup_parent knob.
events_logger = "file"
events_logfile_path = "/srv/mcp-podman/runner/events/events.log"
events_logfile_max_size = "1m"
image_copy_tmp_dir = "/srv/mcp-podman/runner/tmp"
tmp_dir = "/run/user/{{ mcp_runner_uid }}/libpod/tmp"
