[Unit]
Description=Secure MCP Tunnel v0.0.15 (separate credential owner)
Requires=mcp-workspaced.service
After=mcp-workspaced.service network-online.target
Wants=network-online.target
PartOf=mcp-workspaced.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
User=mcp-tunnel
Group=mcp-tunnel
UMask=0077
Environment=HOME=/var/lib/mcp-tunnel
EnvironmentFile=/etc/mcp-tunnel/runtime.env
ExecStart=/usr/local/libexec/tunnel-client run --profile-file /etc/mcp-tunnel/profile.yml
RuntimeDirectory=mcp-tunnel
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/mcp-tunnel /run/mcp-tunnel
LogNamespace=mcp

[Install]
WantedBy=multi-user.target
