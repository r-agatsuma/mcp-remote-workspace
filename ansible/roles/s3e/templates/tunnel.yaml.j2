config_version: 1
control_plane:
  tunnel_id: {{ mcp_tunnel_id }}
  api_key: file:/etc/mcp-tunnel/control-plane-api-key
mcp:
  server_urls:
    - channel: main
      url: http://{{ mcp_production_endpoint.address }}:{{ mcp_production_endpoint.port }}/mcp
  startup_wait_timeout: 60s
health:
  listen_addr: 127.0.0.1:0
admin_ui:
  allow_remote: false
  open_browser: false
  log_buffer_events: 100
log:
  level: warn
  format: json
  http_raw_unsafe: false
