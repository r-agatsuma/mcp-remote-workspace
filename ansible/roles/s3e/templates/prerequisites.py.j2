#!/usr/bin/python3
"""Read-only service prerequisites as mcp-runner; no repair or lifecycle authority."""
import os
from pathlib import Path
import stat
import subprocess
import sys

ENVIRONMENT = {{ mcp_service_environment | to_json }}
UID = {{ mcp_runner_uid }}
GID = {{ mcp_runner_primary_gid }}
UNITS = {{ [mcp_data_mount_unit, mcp_data_ready_unit, mcp_user_manager_unit, 'netfilter-persistent.service', 'systemd-sysctl.service'] | to_json }}
CGROUP = {{ mcp_user_manager_cgroup | to_json }}
RESOLVERS = {{ mcp_workspaced_config['public-dns'] | to_json }}


def verify():
    if os.getuid() != UID or os.geteuid() != UID or os.getgid() != GID:
        raise ValueError('wrong service identity')
    if set(os.getgroups()) - {GID}:
        raise ValueError('unexpected supplementary group')
    if '/mcpws' in Path('/proc/self/cgroup').read_text():
        raise ValueError('control work cannot run inside a finite build parent')
    for unit in UNITS:
        result = subprocess.run(
            ['/usr/bin/systemctl', 'show', '--property=ActiveState', '--value', '--', unit],
            env=ENVIRONMENT, check=True, capture_output=True, text=True, timeout=3)
        if result.stdout.strip() != 'active':
            raise ValueError('inactive prerequisite')
    if not os.path.ismount({{ mcp_data_mount | to_json }}):
        raise ValueError('Data is not mounted')
    runtime = Path(ENVIRONMENT['XDG_RUNTIME_DIR'])
    meta = runtime.lstat()
    if not stat.S_ISDIR(meta.st_mode) or meta.st_uid != UID or stat.S_IMODE(meta.st_mode) != 0o700:
        raise ValueError('unsafe user runtime directory')
    bus = (runtime / 'bus').lstat()
    if not stat.S_ISSOCK(bus.st_mode) or bus.st_uid != UID:
        raise ValueError('missing user bus')
    result = subprocess.run(
        ['/usr/bin/systemctl', '--user', 'show', '--property=ControlGroup', '--value', '--', '-.slice'],
        env=ENVIRONMENT, check=True, capture_output=True, text=True, timeout=3)
    if result.stdout.strip() != CGROUP:
        raise ValueError('wrong user-manager authority')
    controllers = Path('/sys/fs/cgroup' + CGROUP + '/cgroup.controllers').read_text().split()
    if not {'cpu', 'memory', 'pids'} <= set(controllers):
        raise ValueError('missing delegated controllers')
    resolver = Path('/etc/resolv.conf')
    meta = resolver.lstat()
    if not stat.S_ISREG(meta.st_mode) or meta.st_uid != 0 or stat.S_IMODE(meta.st_mode) != 0o644:
        raise ValueError('unsafe trusted resolver file')
    lines = [line.strip() for line in resolver.read_text().splitlines()
             if line.strip() and not line.lstrip().startswith('#')]
    if lines != ['nameserver ' + value for value in RESOLVERS]:
        raise ValueError('resolver configuration drift')
    if Path('/proc/sys/net/ipv4/ping_group_range').read_text().split() != [str(GID), str(GID)]:
        raise ValueError('ping group authority drift')


if __name__ == '__main__':
    try:
        if len(sys.argv) != 1:
            raise ValueError('no arguments accepted')
        verify()
    except (OSError, ValueError, subprocess.SubprocessError):
        sys.exit('STOP: service prerequisites failed; operator reconciliation required')
