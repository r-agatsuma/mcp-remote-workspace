#!/usr/bin/env python3
"""Local source checks only; never run site.yml against an inventory."""
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import tempfile
import unittest

ROOT = Path(__file__).resolve().parents[1]
os.chdir(ROOT)
os.environ['GOTOOLCHAIN'] = 'go1.26.9'
os.environ['PYTHONDONTWRITEBYTECODE'] = '1'
sys.dont_write_bytecode = True
unsupported = []


def run(args, cwd=ROOT):
    print('+ ' + shlex.join(args), flush=True)
    subprocess.run(args, cwd=cwd, check=True)


def unavailable(reason):
    unsupported.append(reason)
    print('UNSUPPORTED / NOT EXECUTED: ' + reason, flush=True)


def verify_deployment_source():
    try:
        import yaml
    except ImportError as exc:
        unavailable('PyYAML repository parsing: ' + str(exc))
    else:
        for path in sorted(ROOT.rglob('*.yml')) + sorted(ROOT.rglob('*.yaml')):
            list(yaml.safe_load_all(path.read_text()))
        print('PASS: repository YAML parsing', flush=True)
    try:
        import ansible  # Existing deployment dependency, never auto-installed.
        import yaml  # The component tests also require PyYAML.
    except ImportError as exc:
        unavailable('Ansible syntax/render/component checks: ' + str(exc))
    else:
        if not shutil.which('ansible-playbook'):
            unavailable('ansible-playbook syntax and render checks')
        else:
            for play in ['site.yml', 'bootstrap-data.yml', 'tests/revision_contract.yml']:
                run(['ansible-playbook', '-i', 'localhost,', '--syntax-check', play], ROOT / 'ansible')
            run(['ansible-playbook', '-i', 'localhost,', '--list-tasks', 'site.yml'], ROOT / 'ansible')
            run(['ansible-inventory', '-i', 'inventory/hosts.example.yml', '--list'], ROOT / 'ansible')
            run(['ansible-playbook', '-i', 'localhost,', 'tests/revision_contract.yml'], ROOT / 'ansible')
            sys.path.insert(0, str(ROOT / 'ansible/tests'))
            suite = unittest.defaultTestLoader.discover(str(ROOT / 'ansible/tests'), 'test_*.py')
            result = unittest.TextTestRunner(verbosity=2).run(suite)
            for test, reason in result.skipped:
                unavailable(str(test) + ': ' + reason)
            if not result.wasSuccessful():
                raise RuntimeError('source/component tests failed')


def main():
    run(['go', 'mod', 'verify'])
    files = subprocess.check_output(['git', 'ls-files', '*.go'], text=True).splitlines()
    print('+ gofmt -l <tracked Go files>', flush=True)
    unformatted = subprocess.check_output(['gofmt', '-l', *files], text=True)
    if unformatted:
        raise RuntimeError('gofmt required:\n' + unformatted)
    run(['go', 'test', './...'])
    # A tiny independent probe distinguishes platform/compiler unavailability
    # from a repository race-test failure, which must remain a failure.
    with tempfile.TemporaryDirectory(prefix='mcp-source-') as directory:
        probe = Path(directory) / 'race.go'
        probe.write_text('package main\nfunc main() {}\n')
        result = subprocess.run(['go', 'build', '-race', '-o', str(Path(directory) / 'race'), str(probe)],
                                text=True, capture_output=True)
        if result.returncode:
            unavailable('race toolchain probe: ' + result.stderr.strip())
        else:
            run(['go', 'test', '-race', './...'])
        run(['go', 'vet', './...'])
        run(['go', 'build', './...'])
        binary = str(Path(directory) / 'mcp-workspaced')
        run(['go', 'build', '-o', binary, './cmd/mcp-workspaced'])
        run([binary, '-smoke'])
        run(['go', 'version', '-m', binary])
        if shutil.which('readelf'):
            run(['readelf', '-l', '-d', binary])
        else:
            unavailable('readelf artifact linkage inspection')
    verify_deployment_source()
    run(['git', 'diff', '--check'])
    run(['git', 'diff', '--cached', '--check'])
    print('Source checks completed' + (' WITH UNSUPPORTED CHECKS' if unsupported else ': PASS'))
    print('NOT EXECUTED: real systemd/Podman/Netfilter/DNS/cgroup, OCI, credential behavior, Tunnel READY, ChatGPT E2E')
    # A partial run is distinguishable to automation as well as to a reader.
    return 2 if unsupported else 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (subprocess.CalledProcessError, RuntimeError) as exc:
        print('FAIL: ' + str(exc), file=sys.stderr)
        sys.exit(1)
